{
  "name": "loveopoly",
  "version": "2.17.0",
  "private": true,
  "description": "Loveopoly: board game keliling dunia untuk pasangan & teman. Vite + JS (ES modules), dihosting di Firebase.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "setup": "playwright install chromium",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "test": "npm run build && npm run test:sim && npm run test:progress && npm run test:flows && npm run test:online && npm run test:ui && npm run test:a11y && npm run test:pwa && npm run test:analytics && npm run test:migrate && npm run test:rules && npm run test:backend",
    "test:sim": "node test/sim.js 200",
    "test:progress": "node test/progress.js",
    "test:flows": "node test/flows.js",
    "test:online": "node test/online.js && node test/online3.js",
    "test:ui": "node test/ui.js",
    "test:a11y": "node test/a11y.js",
    "test:migrate": "node test/migrate.js",
    "test:rules": "firebase emulators:exec --project demo-loveopoly --only firestore,database \"node test/rules.js\"",
    "test:backend": "firebase emulators:exec --project demo-loveopoly --only auth,firestore,database \"node test/backend.js\"",
    "test:smoke": "node test/smoke.js",
    "og-image": "node tools/og-image.mjs",
    "deploy": "npm run build && firebase deploy --only hosting,firestore,database",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy pratinjau --only main --expires 7d",
    "icons": "node tools/icons.mjs",
    "test:pwa": "node test/pwa.js",
    "test:analytics": "node test/analytics.js",
    "balance:flow": "node tools/balance/flow.mjs",
    "balance:couple": "node tools/balance/couple.mjs",
    "balance:seat": "node tools/balance/seat.mjs",
    "shots": "node tools/qa/shots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^3.0.4",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.35.1",
    "globals": "^17.14.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
