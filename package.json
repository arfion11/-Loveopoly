{
  "name": "loveopoly",
  "version": "2.17.0",
  "private": true,
  "description": "Loveopoly: board game keliling dunia untuk pasangan LDR, satu file HTML yang dihosting di Firebase.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node tools/serve.mjs",
    "setup": "playwright install chromium",
    "test": "npm run build && npm run test:sim && npm run test:flows && npm run test:online && npm run test:ui && npm run test:a11y && npm run test:rules && npm run test:backend",
    "test:sim": "node test/sim.js 200",
    "test:flows": "node test/flows.js",
    "test:online": "node test/online.js",
    "test:ui": "node test/ui.js",
    "test:a11y": "node test/a11y.js",
    "test:backend": "firebase emulators:exec --project demo-loveopoly --only auth,firestore,database \"node test/backend.js\"",
    "test:rules": "firebase emulators:exec --project demo-loveopoly --only firestore,database \"node test/rules.js\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore,database",
    "test:smoke": "node test/smoke.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "axe-core": "^4.14.0",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.35.1",
    "playwright": "1.63.0"
  }
}
